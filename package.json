{
  "name": "lambda-captcha",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free image + audio CAPTCHA for server-rendered AWS Lambda apps, with a gate that puts a whole app behind it",
  "license": "AGPL-3.0-or-later",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dynamodb": {
      "types": "./dist/dynamodb.d.ts",
      "default": "./dist/dynamodb.js"
    }
  },
  "typesVersions": {
    "*": {
      "dynamodb": ["dist/dynamodb.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "gen-clips": "scripts/gen-clips.sh"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": { "optional": true },
    "@aws-sdk/lib-dynamodb": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
